# DRAFT: complete referenced bundles, task manifests, subsets and runtime settings.
benchmark_id: nooa-atom-eval-author
revision: 1
cases:
  - case_id: atom-existing
    agent: {path: agents/atom/agent.yml}
    tasks: {path: tasks/existing/tasks.yml}
    subsets: {path: tasks/existing/subsets.json}
  - case_id: atom-generated-zero
    agent: {path: agents/atom/agent.yml}
    tasks: {path: tasks/generated-zero/tasks.yml}
    subsets: {path: tasks/generated-zero/subsets.json}
  - case_id: atom-generated-expanded
    agent: {path: agents/atom/agent.yml}
    tasks: {path: tasks/generated-expanded/tasks.yml}
    subsets: {path: tasks/generated-expanded/subsets.json}
coverage:
  system_id: eval-author
  system_revision: f2e3b78cd19bdee599a76e4d7bdf922595d6c192
  command:
    - /path/to/eval-author/.venv/bin/python
    - /path/to/eval-author/labs/metric-benchmark/eval_author_coverage.py
  settings:
    eval_author_root: /path/to/eval-author
    source_sha256: REPLACE_WITH_PRINT_SOURCE_DIGEST_OUTPUT
    author_command: [/path/to/validated-audit-author-command]
    methods: [tool_calls, capabilities, failure_cases]
    score_scope: overall
  timeout_seconds: 3600  # Illustrative; agree the budget before a run.
execution:
  backend: local_harbor
  n_concurrent_trials: 1
  environment: {type: docker}
scoring:
  metric: reward
  direction: higher_is_better
  completed_statuses: [succeeded]
  attempt_policy: only
missing_policy: error
