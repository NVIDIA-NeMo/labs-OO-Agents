{
  "model": "model",
  "max_tokens": 100,
  "system": [
    {
      "type": "text",
      "text": "stable"
    }
  ],
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "question"
        }
      ]
    }
  ],
  "tools": [
    {
      "name": "lookup",
      "description": "Look up a query.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "strict": true
    }
  ],
  "tool_choice": {
    "type": "auto"
  },
  "output_config": {
    "format": {
      "type": "json_schema",
      "schema": {
        "type": "object",
        "properties": {
          "value": {
            "type": "integer",
            "title": "Value"
          }
        },
        "required": [
          "value"
        ],
        "additionalProperties": false,
        "title": "Answer"
      }
    }
  }
}
